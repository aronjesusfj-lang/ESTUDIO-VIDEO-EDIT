---
import { useTranslations } from "@/i18n/ui"

const t = useTranslations(Astro.currentLocale)
---

<aside class="sidebar">
  <div class="sidebar-head">
    <div id="lang-tabs" class="lang-tabs"></div>
    <select
      id="lang-add-select"
      class="lang-add-select"
      aria-label={t.sidebar.addLangAria}
      disabled
    >
      <option value="">{t.sidebar.addLangOption}</option>
    </select>
    <span id="lang-add-status" class="lang-add-status" hidden></span>
  </div>
  <div
    id="transcript"
    class="transcript"
    role="textbox"
    aria-multiline="true"
    aria-label={t.sidebar.transcriptAria}
  >
    <p class="tx-empty">{t.sidebar.segEmpty}</p>
  </div>
  <div class="sidebar-foot">
    <span id="transcript-hint" class="tx-hint" hidden></span>
    <span id="seg-count" class="seg-count"></span>
    <button id="add-subtitle-btn" class="btn-ghost" type="button">
      {Astro.currentLocale === "es" ? "+ Agregar texto" : "+ Add text"}
    </button>
    <button id="add-text-overlay-btn" class="btn-ghost" type="button">
      {Astro.currentLocale === "es" ? "+ Rótulo" : "+ Title overlay"}
    </button>
    <button id="align-silence-btn" class="btn-ghost" type="button" disabled title={Astro.currentLocale === "es" ? "Ajustar los tiempos a los bordes de voz detectados" : "Align timings to detected speech edges"}>
      {Astro.currentLocale === "es" ? "Ajustar a la voz" : "Align to speech"}
    </button>
  </div>
</aside>
